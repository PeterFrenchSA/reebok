{
  "name": "reebok-house-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "bash scripts/test-integration.sh",
    "test:deploy": "node --test tests/deploy.test.mjs",
    "deploy": "node scripts/deploy/local.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "exceljs": "^4.4.0",
    "google-auth-library": "^10.9.1",
    "next": "15.5.29",
    "nodemailer": "10.5.0",
    "openai": "^6.0.0",
    "papaparse": "^5.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.5.29",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "effect": "3.22.5",
    "source-map-js": "1.2.4",
    "zod": "$zod",
    "postcss": "8.5.33"
  }
